{
  "$deprecated": {
    "note": "Nomes antigos continuam valendo como apelidos até a 2.0. Use os nomes novos.",
    "map": {"--roxo-bright":"--primary-bright","--lilas-soft":"--accent-soft","--gold-deep":"--highlight-deep","--gold-line":"--highlight-line","--rose-line":"--support-line","--gold-ink":"--highlight-ink","--rose-ink":"--support-ink","--roxo2":"--primary","--lilas":"--accent","--peach":"--glow","--roxo":"--primary-deep","--gold":"--highlight","--rose":"--support","--brand-amarelo":"--brand-dourado","--brand-vermelho":"--brand-rosa","--brand-amarelado":"--brand-pessego","color.*.roxoBright":"color.*.primaryBright","color.*.lilasSoft":"color.*.accentSoft","color.*.goldDeep":"color.*.highlightDeep","color.*.goldLine":"color.*.highlightLine","color.*.roseLine":"color.*.supportLine","color.*.goldInk":"color.*.highlightInk","color.*.roseInk":"color.*.supportInk","color.*.roxo2":"color.*.primary","color.*.lilas":"color.*.accent","color.*.peach":"color.*.glow","color.*.roxo":"color.*.primaryDeep","color.*.gold":"color.*.highlight","color.*.rose":"color.*.support","color.brand.amarelo":"color.brand.dourado","color.brand.vermelho":"color.brand.rosa","color.brand.amarelado":"color.brand.pessego"}
  },
  "$meta": {
    "name": "Facial Academy Design System",
    "version": "1.3.0",
    "author": "Edegar Junior",
    "source": "Identidade visual própria da marca",
    "language": "pt-BR",
    "themes": ["dark", "light"],
    "defaultTheme": "dark",
    "note": "Cores derivadas das 7 institucionais. Nada deve sair desta paleta. Aplique tokens, nunca hex solto nos componentes."
  },

  "breakpoints": { "desktop": 1200, "tablet": 810, "phone": 390 },

  "color": {
    "brand": {
      "roxo": "#644389", "lilas": "#A289D7", "dourado": "#FFE4A4",
      "rosa": "#FFB1BD", "pessego": "#FFCA9B", "branco": "#FFFFFF", "preto": "#000000"
    },
    "dark": {
      "bg": "#0A070E", "bg2": "#130D1A", "card": "#1B1225", "card2": "#22172F",
      "line": "rgba(162,137,215,.14)",
      "primaryDeep": "#3A274F", "primary": "#644389", "primaryBright": "#7C5EA7",
      "accent": "#A289D7", "accentSoft": "#B39EDE",
      "cta": "#7C5EA7", "ctaGrad": "linear-gradient(120deg,#7C5EA7,#7354A7)", "ctaSolidH": "#7354A7", "ctaInk": "#fff",
      "txt": "#F9F8FD", "mut": "#C2BAD0", "legalMut": "#826DAD",
      "highlight": "#FFE4A4", "highlightDeep": "#D6C08A", "highlightInk": "#FFE4A4", "highlightLine": "rgba(255,228,164,.42)",
      "support": "#FFB1BD", "supportInk": "#FFB1BD", "supportLine": "rgba(255,177,189,.42)",
      "glow": "#FFCA9B", "logo": "#FFFFFF",
      "success": "#45C08A", "warning": "#E8B53D", "danger": "#FF7D93", "info": "#A289D7",
      "successBg": "rgba(69,192,138,.14)", "warningBg": "rgba(232,181,61,.14)", "dangerBg": "rgba(255,125,147,.14)", "infoBg": "rgba(162,137,215,.14)", "rowSel": "rgba(162,137,215,.16)",
      "shadow": "rgba(100,67,137,.40)", "shadowStrong": "rgba(100,67,137,.50)"
    },
    "light": {
      "bg": "#FAFAFA", "bg2": "#F5F1FB", "card": "#FAF7FE", "card2": "#F1EAFA",
      "line": "rgba(100,67,137,.16)",
      "primaryDeep": "#3A274F", "primary": "#644389", "primaryBright": "#7C5EA7",
      "accent": "#644389", "accentSoft": "#6E59A6",
      "cta": "#644389", "ctaGrad": "linear-gradient(120deg,#644389,#3A274F)", "ctaSolidH": "#7C5EA7", "ctaInk": "#fff",
      "txt": "#241733", "mut": "#6B5C87", "legalMut": "#6B5C87",
      "highlight": "#FFE4A4", "highlightDeep": "#D6C08A", "highlightInk": "#7A5A0E", "highlightLine": "rgba(122,90,14,.55)",
      "support": "#FFB1BD", "supportInk": "#B04A5E", "supportLine": "rgba(176,74,94,.50)",
      "glow": "#FFCA9B", "logo": "#644389",
      "success": "#147A45", "warning": "#8A5A00", "danger": "#BE2C45", "info": "#5E4A8C",
      "successBg": "rgba(31,138,91,.10)", "warningBg": "rgba(138,90,0,.10)", "dangerBg": "rgba(199,47,73,.10)", "infoBg": "rgba(94,74,140,.10)", "rowSel": "rgba(100,67,137,.10)",
      "shadow": "rgba(100,67,137,.18)", "shadowStrong": "rgba(100,67,137,.26)"
    }
  },

  "elevation": {
    "roles": { "raised": "1", "overlay": "3", "modal": "4" },
    "dark": {
      "1": "0 1px 2px rgba(0,0,0,.34), 0 2px 6px rgba(0,0,0,.30)", "2": "0 2px 4px rgba(0,0,0,.34), 0 8px 18px rgba(0,0,0,.40)",
      "3": "0 4px 12px rgba(0,0,0,.45), 0 16px 36px rgba(0,0,0,.55)", "4": "0 10px 24px rgba(0,0,0,.5), 0 28px 64px rgba(0,0,0,.62)"
    },
    "light": {
      "1": "0 1px 2px rgba(100,67,137,.10), 0 2px 6px rgba(100,67,137,.08)", "2": "0 2px 4px rgba(100,67,137,.10), 0 8px 16px rgba(100,67,137,.12)",
      "3": "0 4px 10px rgba(100,67,137,.12), 0 16px 32px rgba(100,67,137,.16)", "4": "0 8px 18px rgba(100,67,137,.14), 0 28px 56px rgba(100,67,137,.22)"
    }
  },

  "radius": { "sm": "8px", "md": "14px", "lg": "18px", "pill": "30px" },
  "foundations": {
    "opacity": { "disabled": 0.45, "muted": 0.66, "hover": 0.08, "overlay": 0.58 },
    "borderWidth": { "hair": "1px", "1": "1px", "2": "2px" },
    "blur": { "sm": "6px", "md": "12px", "lg": "20px" },
    "breakpoint": { "phone": "390px", "tablet": "810px", "desktop": "1200px" },
    "size": { "iconSm": "16px", "icon": "20px", "iconLg": "24px", "controlH": "44px", "touchMin": "44px", "rowH": "46px", "rowHCompact": "38px", "sideW": "248px", "calCell": "38px" },
    "aspectRatio": { "square": "1/1", "photo": "4/3", "wide": "16/9" }
  },
  "space":  { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "6": "24px", "8": "32px", "12": "48px" },
  "zIndex": { "base": 0, "raised": 10, "sticky": 40, "overlay": 100, "toast": 1000 },
  "motion": { "fast": "0.15s", "base": "0.2s", "slow": "0.4s", "ease": "cubic-bezier(.2,.8,.2,1)" },
  "focus":  "0 0 0 2px var(--bg), 0 0 0 4px var(--focus-ring)",
  "focusRing": { "dark": "#A289D7", "light": "#644389" },

  "typography": {
    "fontFamily": "'Silka', 'Poppins', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "weights": [300, 400, 500, 600, 700],
    "note": "size = [desktop, tablet, phone] (px). No CSS use clamp() entre o phone e o desktop. Body mínimo 16px no mobile (evita zoom no iOS).",
    "styles": {
      "Display/H1":  { "size": [60, 44, 34], "weight": 500, "lineHeight": 1.03, "letterSpacing": "-0.025em" },
      "Heading/H2":  { "size": [38, 32, 26], "weight": 500, "lineHeight": 1.12, "letterSpacing": "-0.02em" },
      "Sub/H3":      { "size": [24, 22, 20], "weight": 500, "lineHeight": 1.2 },
      "Sub/H4":      { "size": [20, 19, 18], "weight": 500, "lineHeight": 1.25, "letterSpacing": "-0.01em" },
      "Sub/H5":      { "size": [17, 16, 16], "weight": 500, "lineHeight": 1.3 },
      "Sub/H6":      { "size": [15, 14, 14], "weight": 500, "lineHeight": 1.35 },
      "Eyebrow":     { "size": [12, 12, 11], "weight": 600, "lineHeight": 1.2, "letterSpacing": "0.18em", "uppercase": true, "color": "accent" },
      "Lead":        { "size": [18, 17, 16], "weight": 300, "lineHeight": 1.5, "color": "mut" },
      "Body":        { "size": [16, 16, 16], "weight": 300, "lineHeight": 1.65 },
      "BodySmall":   { "size": [14, 13, 13], "weight": 300, "lineHeight": 1.6, "color": "mut" },
      "Numeral":     { "size": [44, 38, 32], "weight": 700, "lineHeight": 1, "tabularNums": true },
      "Legal":       { "size": [12, 11, 11], "weight": 300, "lineHeight": 1.5, "color": "legalMut" }
    }
  },

  "components": {
    "button": {
      "radius": "pill", "minHeight": "44px",
      "variants": ["fill", "solid", "outline", "ghost", "highlight", "highlight-o"],
      "sizes": { "sm": "10px 18px / 13px", "md": "14px 26px / 15px", "lg": "17px 32px / 16px" },
      "states": ["hover", "active", "focus-visible", "disabled"],
      "icon": "Phosphor Thin, currentColor, 18px (15 sm / 19 lg)"
    },
    "statusColors": ["success", "warning", "danger", "info"]
  },

  "icons": { "library": "Phosphor", "weight": "Thin", "stroke": "1pt (stroke-width 1 na grade 24)", "color": "currentColor" },

  "gradients": {
    "rule": "Somente cores do brand. NÃO usar conic, blob ou halo. Preferir meshes (radiais multiponto) e lineares.",
    "examples": {
      "primary": "linear-gradient(120deg,#644389,#3A274F)",
      "spectral": "linear-gradient(110deg,#3A274F,#644389 28%,#A289D7 54%,#FFB1BD 80%,#FFCA9B)",
      "mesh": "radial-gradient(at 18% 22%,rgba(162,137,215,.55) 0,transparent 45%),radial-gradient(at 78% 18%,rgba(255,177,189,.30) 0,transparent 42%),radial-gradient(at 68% 78%,rgba(100,67,137,.70) 0,transparent 50%),radial-gradient(at 30% 92%,rgba(255,202,155,.22) 0,transparent 46%),#0A070E"
    }
  },

  "accessibility": {
    "contrast": "WCAG AA — texto normal ≥4.5:1, texto grande/UI ≥3:1. No light, dourado/rosa como TEXTO usam -ink.",
    "focus": "outline:2px solid var(--accent) + box-shadow var(--focus); guard @media (forced-colors: active).",
    "reducedMotion": "Respeitar prefers-reduced-motion.",
    "touchTarget": "≥44px.",
    "colorNotAlone": "Estados semânticos sempre com ícone + texto, nunca só cor."
  }
}
